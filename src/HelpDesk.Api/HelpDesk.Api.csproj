<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>HelpDesk.Api</RootNamespace>
    <AssemblyName>HelpDesk.Api</AssemblyName>
    <Version>1.0.0</Version>
    <Product>Mesa de Ayuda ASSE - IntegradoC</Product>
    <!-- Necesario para normalizar acentos (búsquedas sin tildes) -->
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Dapper" Version="2.1.*" />
    <PackageReference Include="Npgsql" Version="9.0.*" />
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="10.0.*" />
  </ItemGroup>

  <ItemGroup>
    <!-- Los scripts SQL de /database se incrustan en el ejecutable y se aplican al iniciar -->
    <EmbeddedResource Include="..\..\database\*.sql" LogicalName="Scripts.%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
