# Copiar este archivo como ".env" (en la misma carpeta que docker-compose.yml) y ajustar los valores.
# docker compose lo lee automáticamente.

# --- PostgreSQL ---------------------------------------------------------------
# Se aplican SOLO la primera vez, cuando se crea el volumen de datos.
POSTGRES_DB=helpdeskasse
POSTGRES_USER=helpdesk
# Evitar el carácter ";" (se usa en la cadena de conexión del backend).
POSTGRES_PASSWORD=cambiar-esta-clave

# --- Aplicación -----------------------------------------------------------------
# Contraseña del usuario "admin" que se crea la primera vez (se pide cambiarla al entrar).
# Si se deja vacía, se genera una al azar y aparece en: docker compose logs backend
ADMIN_PASSWORD_INICIAL=
HORAS_SESION=12

# --- Puertos en esta PC -----------------------------------------------------------
FRONTEND_PORT=8080
# Backend y PostgreSQL quedan publicados solo en 127.0.0.1 (diagnóstico / pgAdmin).
BACKEND_PORT=5080
POSTGRES_PORT=5432
